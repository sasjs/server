{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:8787/",
        "http://localhost:8787/installation/",
        "http://localhost:8787/apps/",
        "http://localhost:8787/sessions/",
        "http://localhost:8787/storedprograms/",
        "http://localhost:8787/testing-va-embed/",
        "http://localhost:8787/settings/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--headless=new --no-sandbox --disable-dev-shm-usage --disable-gpu"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          { "minScore": 0.85, "aggregationMethod": "median" }
        ],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "total-byte-weight": [
          "error",
          { "maxNumericValue": 950000, "aggregationMethod": "median" }
        ],
        "aria-dialog-name": "error",
        "unsized-images": "error",
        "color-contrast": "error",
        "heading-order": "error",
        "link-name": "error",
        "link-text": "error",
        "image-alt": "error"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouse-reports"
    }
  }
}
