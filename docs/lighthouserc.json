{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:8787/",
        "http://localhost:8787/installation/",
        "http://localhost:8787/apps/",
        "http://localhost:8787/sessions/",
        "http://localhost:8787/storedprograms/",
        "http://localhost:8787/testing-va-embed/",
        "http://localhost:8787/settings/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--headless=new --no-sandbox --disable-dev-shm-usage --disable-gpu"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.85,
            "aggregationMethod": "median"
          }
        ],
        "categories:accessibility": [
          "warn",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "warn",
          {
            "minScore": 0.95
          }
        ],
        "total-byte-weight": [
          "warn",
          {
            "maxNumericValue": 950000,
            "aggregationMethod": "median"
          }
        ],
        "aria-dialog-name": "warn",
        "unsized-images": "warn",
        "color-contrast": "warn",
        "heading-order": "warn",
        "link-name": "warn",
        "link-text": "warn",
        "image-alt": "warn"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouse-reports"
    }
  }
}
