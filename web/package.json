    "react-highlight": "^0.15.0",
    "react-monaco-editor": "^0.59.0",
    "react-router-dom": "^7.18.4",
    "react-toastify": "^11.1.0",
    "vscode-languageserver-protocol": "3.18.4"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/node": "^8.0.6",
