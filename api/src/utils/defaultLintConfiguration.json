{
  "$schema": "https://cli.sasjs.io/sasjslint-schema.json",
  "allowedGremlins": [],
  "bannedStrings": ["error ", "error:", "warning ", "warning:"],
  "defaultHeader": "/**{lineEnding}  @file{lineEnding}  @brief <Your brief here>{lineEnding}{lineEnding}  <h4> SAS Macros </h4>{lineEnding}{lineEnding}**/",
  "hasDoxygenHeader": false,
  "hasMacroNameInMend": true,
  "hasMacroParentheses": true,
  "hasRequiredMacroOptions": false,
  "ignoreList": [],
  "ignoredLibnames": [],
  "ignoredMacros": ["webout"],
  "indentationMultiple": 2,
  "lineEndings": "off",
  "lowerCaseFileNames": true,
  "lowerCaseMacroNames": true,
  "maxDataLineLength": 80,
  "maxHeaderLineLength": 80,
  "maxLineLength": 80,
  "minMacroNameLength": 3,
  "noBannedStrings": true,
  "noEncodedPasswords": true,
  "noGremlins": true,
  "noMacroIfInOpenCode": false,
  "noNestedCommentsInHeader": true,
  "noNestedMacros": true,
  "noSingleAsteriskComments": false,
  "noSpacesInFileNames": true,
  "noTabs": true,
  "noTrailingSpaces": true,
  "noUndeclaredMacros": true,
  "noUnusedLibnames": false,
  "noUnusedMacros": true,
  "noXcmd": true,
  "requiredMacroOptions": [],
  "strictMacroDefinition": true,
  "severityLevel": {
    "hasDoxygenHeader": "warn",
    "hasMacroNameInMend": "warn",
    "hasMacroParentheses": "warn",
    "hasRequiredMacroOptions": "warn",
    "indentationMultiple": "warn",
    "lineEndings": "warn",
    "lowerCaseFileNames": "warn",
    "lowerCaseMacroNames": "warn",
    "maxLineLength": "warn",
    "minMacroNameLength": "warn",
    "noBannedStrings": "warn",
    "noEncodedPasswords": "error",
    "noGremlins": "warn",
    "noMacroIfInOpenCode": "warn",
    "noNestedCommentsInHeader": "warn",
    "noNestedMacros": "warn",
    "noSingleAsteriskComments": "warn",
    "noSpacesInFileNames": "warn",
    "noTabs": "warn",
    "noTrailingSpaces": "warn",
    "noUndeclaredMacros": "warn",
    "noUnusedLibnames": "warn",
    "noUnusedMacros": "warn",
    "noXcmd": "warn",
    "strictMacroDefinition": "warn"
  }
}
