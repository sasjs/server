MODE=[desktop|server] default considered as desktop

# The account the server must run as. Unset: the server refuses to start as
# root. Set to a username: the server must be running as that account, or it
# refuses to start. RUN_AS=root is the deliberate override. The server
# executes uploaded code, so its identity is the privilege every connected
# user gets.
RUN_AS=

CORS=[disable|enable] default considered as disable for server MODE & enable for desktop MODE
ALLOWED_DOMAIN=<just domain e.g. example.com >
WHITELIST=<space separated urls, each starting with protocol `http` or `https`>

# each port variable enables its listener; unset, empty or 0 disables it.
# at least one of the two must be set.
HTTP_PORT=[5000]
HTTP_BIND_ADDRESS=[127.0.0.1] interface the plain HTTP listener binds to
HTTP_ALLOW_REMOTE=[true|false] required to bind plain HTTP beyond loopback
HTTPS_PORT=[443]
HTTPS_BIND_ADDRESS=every interface when omitted

# TLS material, required when HTTPS_PORT is set
PRIVATE_KEY=privkey.pem
CERT_CHAIN=certificate.pem
CA_ROOT=fullchain.pem

# PROTOCOL and PORT are deprecated: they are translated into the matching port
# variable for one release, with a warning.

HELMET_CSP_CONFIG_PATH=./csp.config.json if omitted HELMET default will be used
HELMET_COEP=[true|false] if omitted HELMET default will be used

DB_CONNECT=mongodb+srv://<DB_USERNAME>:<DB_PASSWORD>@<CLUSTER>/<DB_NAME>?retryWrites=true&w=majority
DB_TYPE=[mongodb|cosmos_mongodb] default considered as mongodb

AUTH_PROVIDERS=[ldap]

LDAP_URL= <LDAP_SERVER_URL>
LDAP_BIND_DN= <cn=admin,ou=system,dc=cloudron>
LDAP_BIND_PASSWORD = <password>
LDAP_USERS_BASE_DN = <ou=users,dc=cloudron>
LDAP_GROUPS_BASE_DN = <ou=groups,dc=cloudron>

#default value is 100
MAX_WRONG_ATTEMPTS_BY_IP_PER_DAY=100

#default value is 10
MAX_CONSECUTIVE_FAILS_BY_USERNAME_AND_IP=10

ADMIN_USERNAME=secretuser
ADMIN_PASSWORD_INITIAL=secretpassword
ADMIN_PASSWORD_RESET=NO

RUN_TIMES=[sas,js,py | js,py | sas | sas,js] default considered as sas
SAS_PATH=/opt/sas/sas9/SASHome/SASFoundation/9.4/sas
NODE_PATH=~/.nvm/versions/node/v16.14.0/bin/node
PYTHON_PATH=/usr/bin/python
R_PATH=/usr/bin/Rscript

SASJS_ROOT=./sasjs_root
DRIVE_LOCATION=./sasjs_root/drive

LOG_FORMAT_MORGAN=common
LOG_LOCATION=./sasjs_root/logs