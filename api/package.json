{
  "name": "api",
  "version": "0.0.2",
  "description": "Api of SASjs server",
  "main": "./src/server.ts",
  "scripts": {
    "initial": "npm run swagger && npm run compileSysInit && npm run copySASjsCore && npm run downloadMacros",
    "prestart": "npm run initial",
    "start": "NODE_ENV=development nodemon ./src/server.ts",
    "start:prod": "node ./build/src/server.js",
    "build": "npm run initial && rimraf build && tsc && npm run copy:files",
    "swagger": "tsoa spec",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath ./.git-hooks",
    "test": "mkdir -p tmp && mkdir -p ../web/build && jest --silent --coverage",
    "lint:fix": "npx prettier --write \"src/**/*.{ts,tsx,js,jsx,html,css,sass,less,yml,md,graphql}\"",
    "lint": "npx prettier --check \"src/**/*.{ts,tsx,js,jsx,html,css,sass,less,yml,md,graphql}\"",
    "exe": "npm run build && pkg .",
    "copy:files": "npm run public:copy && npm run sasjsbuild:copy && npm run sas:copy && npm run web:copy",
    "public:copy": "cpr ./public/ ./build/public/",
    "sasjsbuild:copy": "cpr ./sasjsbuild/ ./build/sasjsbuild/",
    "sas:copy": "cpr ./sas/ ./build/sas/",
    "web:copy": "rimraf web && mkdir web && cpr ../web/build/ ./web/build/",
    "compileSysInit": "ts-node ./scripts/compileSysInit.ts",
    "copySASjsCore": "ts-node ./scripts/copySASjsCore.ts",
    "downloadMacros": "ts-node ./scripts/downloadMacros.ts"
  },
  "bin": "./build/src/server.js",
  "pkg": {
    "assets": [
      "./build/public/**/*",
      "./build/sasjsbuild/**/*",
      "./build/sas/**/*",
      "./web/build/**/*"
    ],
    "targets": [
      "node24-linux-x64",
      "node24-macos-x64",
      "node24-win-x64"
    ],
    "outputPath": "../executables"
  },
  "release": {
    "branches": [
      "main"
    ]
  },
  "author": "4GL Ltd",
  "dependencies": {
    "@sasjs/core": "^5.2.10",
    "@sasjs/utils": "^3.6.2",
    "bcryptjs": "^3.0.3",
    "connect-mongo": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csrf": "^3.1.0",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "http-headers-validation": "^0.0.2",
    "joi": "^18.2.9",
    "jose": "5.10.0",
    "jsonwebtoken": "^9.0.3",
    "ldapjs": "2.3.3",
    "mongoose": "^8.24.4",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "rotating-file-stream": "^3.2.10",
    "swagger-ui-express": "5.0.1",
    "tsoa": "5.1.1",
    "unzipper": "^0.12.5",
    "url": "^0.11.4"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ldapjs": "^2.2.4",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.2",
    "@types/semver": "^7.8.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/unzipper": "^0.10.11",
    "@yao-pkg/pkg": "^6.22.0",
    "adm-zip": "^0.6.1",
    "axios": "^1.20.0",
    "cpr": "^3.0.1",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "nodejs-file-downloader": "^4.13.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "nodemonConfig": {
    "ignore": [
      "sasjs_root/**/*"
    ]
  }
}
